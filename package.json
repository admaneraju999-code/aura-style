{
  "name": "aura-style-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "db:init": "node scripts/setup-db.js",
    "build:css": "tailwindcss -c tailwind.config.js -i css/input.css -o css/tailwind.css --minify",
    "test": "node tests/scan.test.mjs && node tests/validation.test.mjs"
  },
  "dependencies": {
    "@vercel/postgres": "^0.10.0",
    "busboy": "^1.6.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "3.4"
  }
}
